{
  "permissions": {
    "allow": [
      "Bash(npm run dev)", "Bash(npm test)", "Bash(npm run test:watch)",
      "Bash(npm run lint)", "Bash(npx vitest *)", "Bash(npx tsc --noEmit*)",
      "Bash(npx playwright *)", "Bash(node -e *)", "Bash(python3 -c *)",
      "Bash(python3 -m json.tool)", "Bash(curl -s *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git status*)",
      "Bash(git diff *)", "Bash(git log *)", "Bash(git stash *)",
      "Read(//tmp/**)",
      "PowerShell(npm run dev)", "PowerShell(npx tsc --noEmit*)",
      "PowerShell(npx vitest run*)",
      "PowerShell(Get-NetTCPConnection -LocalPort 3010 *)",
      "PowerShell(Get-Process node *)", "PowerShell(Stop-Process *)",
      "PowerShell(Start-Process powershell *)", "PowerShell(Remove-Item *)",
      "PowerShell(Invoke-WebRequest *)", "PowerShell(Invoke-RestMethod *)",
      "mcp__claude_ai_Airtable__list_bases", "mcp__claude_ai_Airtable__search_bases",
      "mcp__claude_ai_Airtable__list_tables_for_base",
      "mcp__claude_ai_Airtable__get_table_schema",
      "mcp__claude_ai_Airtable__list_records_for_table",
      "mcp__claude_ai_Airtable__search_records"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|PowerShell",
        "hooks": [ { "type": "command", "command": "node .claude/hooks/block-build-during-dev.mjs" } ] }
    ]
  }
}