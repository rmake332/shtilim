# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — NEVER commit the real token.

# Airtable Personal Access Token (server-side only, never NEXT_PUBLIC_)
AIRTABLE_TOKEN=

# Airtable base id for תשפ"ז
AIRTABLE_BASE_ID=appKlvldLrk14ird8

# Set to 1 to use local mock fixtures instead of hitting Airtable (development)
AIRTABLE_MOCK=0

# Secret used to sign/verify institution tokens (generate a long random string)
TOKEN_SECRET=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Make.com webhook fired on every position submit/edit (optional — has a default).
SUBMIT_POSITION_WEBHOOK_URL=https://hook.eu2.make.com/gwynlqfizihyw5xr2pugvy2tthh0v1st

# Make.com webhook for developer error alerts (Airtable-write / Make-webhook failures).
# The scenario behind it appends a row to a Google Sheet and emails the developer.
# If empty, alerts are only written to the server log.
ERROR_WEBHOOK_URL=

# Shared secret for POST /api/revalidate (cache flush called by the Airtable
# automation). Generate a long random string; without it the endpoint returns 500.
# See docs/airtable-cache-revalidation.md
REVALIDATE_SECRET=

# OAuth2 (as a real Google account, NOT a service account) used to generate "בקשת
# תשלום" Google Docs for תקני חשבונית (Drive API only, no Docs API, no template file).
# A plain service account has zero Drive storage quota of its own, and Shared
# Drive / domain-wide delegation both require Google Workspace, so for a regular
# Gmail account, docs are created as the real user via a one-time OAuth grant instead.
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web app):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generated once via https://developers.google.com/oauthplayground (own credentials,
# scope https://www.googleapis.com/auth/drive), does not expire unless revoked.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Folder id (from its Drive URL) where generated payment-request docs are created,
# must be owned by (or shared with edit access to) the same Google account.
GOOGLE_PAYMENT_DEST_FOLDER_ID=

# Make.com webhook fired when a "בקשת תשלום" doc is ready, so the scenario can email
# it (to + cc), attaching the merged PDF from Drive by fileId (optional - has a default).
PAYMENT_REQUEST_EMAIL_WEBHOOK_URL=https://hook.eu2.make.com/2gqxp8ban4dqv5ht7fz73hkbcslahfdj/
